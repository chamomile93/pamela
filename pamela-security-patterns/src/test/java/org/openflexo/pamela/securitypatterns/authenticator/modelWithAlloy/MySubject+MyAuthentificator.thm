<?xml version="1.0"?>
<alloy>

<view>

<defaultnode/>

<defaultedge/>

<node>
   <type name="False"/>
   <type name="Int"/>
   <type name="MySubject"/>
   <type name="True"/>
   <type name="univ"/>
   <type name="MyAuthenticator/MyAuthenticator"/>
   <type name="seq/Int"/>
</node>

<node visible="no">
   <type name="Bool"/>
   <type name="String"/>
</node>

<edge style="inherit" visible="no" attribute="yes">
   <relation name="authInfo"> <type name="MySubject"/> <type name="String"/> </relation>
   <relation name="idProof"> <type name="MySubject"/> <type name="Int"/> </relation>
</edge>

<edge visible="no" attribute="yes">
   <relation name="AUTH_INFO"> <type name="MySubject"/> <type name="String"/> </relation>
   <relation name="ID_PROOF"> <type name="MySubject"/> <type name="String"/> </relation>
   <relation name="isAuthenticated"> <type name="MySubject"/> <type name="True"/> </relation>
   <relation name="MANAGER"> <type name="MySubject"/> <type name="String"/> </relation>
   <relation name="PATTERN_ID"> <type name="MySubject"/> <type name="String"/> </relation>
</edge>

</view>

</alloy>
